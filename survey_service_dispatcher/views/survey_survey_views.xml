<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_survey_view_form_dispatcher" model="ir.ui.view">
        <field name="name">survey.survey.view.form.dispatcher</field>
        <field name="model">survey.survey</field>
        <!-- CORRECT ID: survey.survey_form -->
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="is_service_dispatcher"/>
            </xpath>

            <xpath expr="//page[@name='options']" position="after">
                <!-- Odoo 18 Syntax: invisible="expression" -->
                <page string="Service Dispatcher Links" invisible="not is_service_dispatcher">
                    <group>
                        <group string="Service URLs">
                            <field name="url_therapy" placeholder="e.g. /survey/start/therapy"/>
                            <field name="url_teen_therapy" placeholder="e.g. /survey/start/teen"/>
                            <field name="url_couples_therapy" placeholder="e.g. /survey/start/couples"/>
                            <field name="url_psychiatry" placeholder="e.g. /survey/start/psychiatry"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>