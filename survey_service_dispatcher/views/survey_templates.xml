<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="survey_fill_form_start_dispatcher" inherit_id="survey.survey_fill_form_start">
        <xpath expr="//div[@class='wrap o_survey_start']" position="replace">

        <t t-if="survey.is_auto_start and not survey.is_service_dispatcher">
            <!-- Fullscreen Overlay -->
            <div class="o_survey_start d-flex flex-column align-items-center justify-content-center bg-white"
                 style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 9999;">

                <div class="text-center">
                    <span class="fa fa-spinner fa-spin fa-4x text-primary mb-4"></span>
                    <h2 class="text-muted fw-light">Starting survey...</h2>
                </div>

                <!-- Hidden button to trigger submission -->
                <button type="submit" value="start" class="d-none" id="survey_auto_start_trigger"></button>
            </div>
        </t>

            <!-- KEEP ORIGINAL CONTENT IF NOT DISPATCHER -->
            <div class="wrap o_survey_start" t-if="not survey.is_service_dispatcher">
                <div class='mb32'>
                    <div t-field='survey.description' class="oe_no_empty pb-5 text-break"/>
                    <t t-if="answer.is_session_answer">
                        <div class="fw-bold">The session will begin automatically when the host starts.</div>
                    </t>
                    <t t-else="">
                        <div t-if="survey.is_time_limited">
                            <p>
                                <span t-if="not survey.certification">Time limit for this survey: </span>
                                <span t-else="">Time limit for this certification: </span>
                                <span class="fw-bold text-danger" t-field="survey.time_limit" t-options="{'widget': 'duration', 'unit': 'minute'}"></span>
                            </p>
                        </div>
                        <button type="submit" value="start" class="btn btn-primary btn-lg disabled">
                            <t t-if="survey.certification">Start Certification</t>
                            <t t-else="">Start Survey</t>
                        </button>
                        <span class="o_survey_enter fw-bold text-muted ms-2 d-none d-md-inline">or press Enter</span>
                    </t>
                </div>
            </div>

            <!-- NEW DISPATCHER LAYOUT -->
            <div class="wrap o_survey_start" t-if="survey.is_service_dispatcher">
                <style>
                    .o_survey_header { display: none !important; }
                    h1[t-field="survey.title"], .o_survey_main_title, .jumbotron h1 {
                    display: none !important;
                }
                </style>

                <div class="text-center mb-4">
                    <h1 t-field="survey.title" class="fw-bold display-4" />
                    <hr class="mt-4 mb-5" style="width: 100%; margin: 0 auto; border-top: 2px solid #eee; opacity: 10;" />
                </div>

                <div class="text-center mb-5">
                    <h2 class="fw-bold" style="color: #333;">What type of service are you looking for?</h2>
                    <p class="text-muted">Talkspace offers comprehensive options to meet all your mental health needs</p>
                </div>

                <div class="row justify-content-center">
                    <div class="col-12 col-md-10 col-lg-8">

                        <!-- 1. Therapy -->
                        <a t-att-href="survey.url_therapy or '#'" class="text-decoration-none text-dark">
                            <div class="card mb-4 shadow-sm" style="background-color: #dbece5; cursor: pointer; border: 2px solid #2c5d58; border-radius: 12px; min-height: 120px;">
                                <div class="card-body d-flex align-items-center justify-content-between p-4">
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-2" style="color: #2c5d58; font-size: 1.25rem;">Therapy</h5>
                                        <small class="text-muted d-block" style="color: #4a6b66 !important; font-size: 0.95rem;">Individualized support from a licensed therapist for ages 18+</small>
                                    </div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 ms-3" style="width: 50px; height: 50px; background-color: #2c5d58 !important;">
                                        <i class="fa fa-comment text-white" style="font-size: 1.5rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <!-- 2. Teen Therapy -->
                        <a t-att-href="survey.url_teen_therapy or '#'" class="text-decoration-none text-dark">
                            <div class="card mb-4 shadow-sm" style="background-color: #f2f0c9; cursor: pointer; border: 2px solid #9ba146; border-radius: 12px; min-height: 120px;">
                                <div class="card-body d-flex align-items-center justify-content-between p-4">
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-2" style="color: #6b6623; font-size: 1.25rem;">Teen Therapy</h5>
                                        <small class="text-muted d-block" style="color: #6b6623 !important; font-size: 0.95rem;">Specialized support designed for youth ages 13-17</small>
                                    </div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 ms-3" style="width: 50px; height: 50px; background-color: #9ba146 !important;">
                                        <i class="fa fa-comment-o text-white" style="font-size: 1.5rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <!-- 3. Couples Therapy -->
                        <a t-att-href="survey.url_couples_therapy or '#'" class="text-decoration-none text-dark">
                            <div class="card mb-4 shadow-sm" style="background-color: #d3e2f2; cursor: pointer; border: 2px solid #2e5e8e; border-radius: 12px; min-height: 120px;">
                                <div class="card-body d-flex align-items-center justify-content-between p-4">
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-2" style="color: #2c4a6b; font-size: 1.25rem;">Couples Therapy</h5>
                                        <small class="text-muted d-block" style="color: #2c4a6b !important; font-size: 0.95rem;">Relationship support to improve your connection with your partner</small>
                                    </div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 ms-3" style="width: 50px; height: 50px; background-color: #2e5e8e !important;">
                                        <i class="fa fa-users text-white" style="font-size: 1.5rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <!-- 4. Psychiatry -->
                        <a t-att-href="survey.url_family_therapy or '#'" class="text-decoration-none text-dark">
                            <div class="card mb-4 shadow-sm" style="background-color: #f0d5d5; cursor: pointer; border: 2px solid #c95d40; border-radius: 12px; min-height: 120px;">
                                <div class="card-body d-flex align-items-center justify-content-between p-4">
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold mb-2" style="color: #6b2c2c; font-size: 1.25rem;">Family Therapy</h5>
                                        <small class="text-muted d-block" style="color: #6b2c2c !important; font-size: 0.95rem;">Family evaluations, diagnoses, and medication</small>
                                    </div>
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 ms-3" style="width: 50px; height: 50px; background-color: #c95d40 !important;">
                                        <i class="fa fa-medkit text-white" style="font-size: 1.5rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </a>

                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>